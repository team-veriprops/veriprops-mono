      "Read(frontend/node_modules/**)",
      "Read(.next/**)",
      "Read(frontend/.next/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(frontend/dist/**)",
      "Read(frontend/coverage/**)",
      "Read(**/*.egg-info/**)"
    ],
    "additionalDirectories": [
      "C:\\Veriprops\\repos\\veriprops-mono\\frontend\\src\\app\\admin\\tasks\\[taskId]",
      "C:\\Veriprops\\repos\\veriprops-mono\\frontend\\src\\app\\portal\\verifications\\[id]"
    ]
