      "Bash(.venv/Scripts/pip.exe install *)",
      "Bash(pip install *)",
      "Bash(pip check *)",
      "Bash(pip show *)",
      "Bash(pnpm --version)",
      "Bash(pnpm install *)",
      "Bash(pnpm build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm vitest *)",
      "Bash(mkdir -p *)",
      "Bash(Get-ChildItem *)",
      "Bash(git stash *)",
