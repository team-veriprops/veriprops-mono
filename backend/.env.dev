# ==============================================================================
# Veriprops backend — DEV (deployed) environment (.env.dev)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `APPODUS_ACTIVE_ENV=dev` — the shared, deployed development
# environment (dev.veriprops.ng), NOT a developer's machine (that is .env.dev_personal).
# Secrets are Doppler-managed (`dev` config) and injected as process env vars,
# which override this file. CHANGE_ME values are inert placeholders — the hygiene
# guard test (test/unit/app/config/test_env_hygiene.py) enforces this.
# See backend/.env.example for the full set of settable keys and their possible values.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=dev                      # dev_personal | dev | test | staging | prod
APP_DOMAIN=https://api-dev.veriprops.ng   # absolute URL of this backend
SHOW_API=true                        # true | false  (docs stay visible on dev)
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name (within LOGGER_FILE_PATH)
DISABLE_RATE_LIMITING=true           # true | false  (QA convenience; MUST be false in prod)
ENABLE_OUT_MESSAGING=false           # true | false  (flip via Doppler when QA needs real delivery)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops                      # brand slug
BRAND_SUPPORT_EMAIL=support@veriprops.ng   # customer support address
BRAND_SUPPORT_PHONE=                 # E.164 digits, no + (blank = none)

# --- Auth / JWT (real dev key via Doppler; policy enforced only in prod/staging) -
AUTHJWT_SECRET_KEY=CHANGE_ME         # SECRET: HS256 signing key — real value via Doppler `dev`

# --- OTP --------------------------------------------------------------------------
# deterministic => every OTP is TEST_OTP (654123); random => CSPRNG codes.
OTP_MODE=deterministic               # deterministic | random  (deterministic on dev so QA can log in without SMS)

# --- WhatsApp channel / bot (§26) --------------------------------------------------
# Stub transports on dev, deliberately — staging is where the live path is exercised
# (it owns Meta's test number and its recipient allowlist), and a second environment on
# `meta` would need a third number. Here outbound goes to the in-process outbox
# (GET /dev/whatsapp/outbox) and inbound arrives via POST /dev/whatsapp/inbound, which is
# what the drive-through drives. The handoff keypair is optional too: an ephemeral RS256
# pair is generated per process outside prod/staging.
WHATSAPP_PROVIDER=stub               # stub | meta
# The classifier can be flipped independently of the transport — nothing about DeepSeek
# needs Meta — so dev can answer like prod with only a key added to Doppler `dev`.
INTENT_PROVIDER=stub                 # stub | anthropic | openai_compatible  (flip to openai_compatible + INTENT_API_KEY for the live classifier)

# --- Database (password via Doppler) ------------------------------------------------
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg         # SQLAlchemy driver scheme
DB_SERVER=pg-2d5721ad-learningforge.b.aivencloud.com   # managed Postgres host (Aiven)
DB_PORT=17637                        # DB port (int)
DB_USER=avnadmin                     # DB user
DB_PASSWORD=CHANGE_ME                # SECRET: via Doppler `dev`
DB_NAME=veriprops_dev                # database name
DB_ENABLE_LOGS=false                 # true | false  (echoes SQL + bound params — false in prod)

# --- Email (Mailpit is not reachable from a deployment; delivery stays off until
# --- a real provider credential is set in Doppler and ENABLE_OUT_MESSAGING flips) -
EMAIL_FROM_ADDRESS=noreply@veriprops.dev   # valid TLD required
EMAIL_FROM_NAME=Veriprops            # display name on outbound email

# --- Redis / KV ----------------------------------------------------------------------
REDIS_ENABLED=false                  # true | false  (false = RedisUtils falls back to the SQL KV store)

# --- CORS / OAuth origins ---------------------------------------------------------------
ALLOWED_ORIGINS=https://dev.veriprops.ng,http://localhost:3000   # comma-separated absolute origins (CORS allowlist)
BACKEND_PUBLIC_ORIGIN=https://api-dev.veriprops.ng               # public origin of this backend service
OAUTH_CALLBACK_BASE_URL=https://dev.veriprops.ng                 # origin OAuth redirects land on
OAUTH_FRONTEND_ORIGINS=https://dev.veriprops.ng,http://localhost:3000   # comma-separated postMessage allowlist

# --- OAuth providers (client ids are public; secrets via Doppler) -----------------------
GOOGLE_CLIENT_ID=477237984032-1dnvhncoq16mk3j2ebjque7gp9vapsqp.apps.googleusercontent.com   # Google OAuth client id (public)
GOOGLE_CLIENT_SECRET=CHANGE_ME       # SECRET: via Doppler `dev`
FACEBOOK_APP_ID=mock_value           # Facebook app id (public identifier)
FACEBOOK_APP_SECRET=CHANGE_ME        # SECRET: via Doppler `dev`
APPLE_TEAM_ID=mock_value             # Apple developer team id (public identifier)
APPLE_CLIENT_ID=mock_value           # Apple services id (public identifier)
APPLE_KEY_ID=mock_value              # Apple key id (for the client-secret JWT)
APPLE_PRIVATE_KEY=CHANGE_ME          # SECRET: via Doppler `dev`

# --- Payments (stub mode; sandbox keys via Doppler when exercising the gateway) ----------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack | stripe (stripe is enum-only — no live integration yet)
PAYMENT_STUB_MODE=true               # true | false  (MUST be false in prod)
FLUTTERWAVE_PUBLIC_KEY=CHANGE_ME     # via Doppler `dev` (sandbox key)
FLUTTERWAVE_SECRET_KEY=CHANGE_ME     # SECRET: via Doppler `dev`
FLUTTERWAVE_WEBHOOK_SECRET=CHANGE_ME # SECRET: via Doppler `dev`
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3   # Flutterwave API base URL
PAYSTACK_PUBLIC_KEY=CHANGE_ME        # via Doppler `dev` (sandbox key)
PAYSTACK_SECRET_KEY=CHANGE_ME        # SECRET: via Doppler `dev`
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME    # SECRET: via Doppler `dev`
PAYSTACK_BASE_URL=https://api.paystack.co   # Paystack API base URL

# --- Feature flags / stub modes -----------------------------------------------------------
DOCUMENT_STORAGE_STUB_MODE=true      # true | false  (true = no real S3/R2 writes)
REPORT_PDF_STUB_MODE=true            # true | false  (false = real fpdf2 renderer)
PHONE_VERIFICATION_ENABLED=false     # true | false  (false = phone verified later, at the payment step)
LEGAL_OPINION_ENABLED=false          # true | false  (launch gate — never default-on)
SCHEDULER_ENABLED=true               # true | false  (disabled under test)
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Super admin seed (password via Doppler `dev`) ------------------------------------------
SUPER_ADMIN_EMAIL=admin@veriprops.dev   # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=CHANGE_ME       # SECRET: via Doppler `dev`

# --- Third-party integration keys — ALL via Doppler -----------------------------------------
AWS_ACCESS_KEY=CHANGE_ME             # SECRET: via Doppler `dev`
AWS_SECRET_ACCESS_KEY=CHANGE_ME      # SECRET: via Doppler `dev`
TERMII_API_KEY=CHANGE_ME             # SECRET: via Doppler `dev`
TERMII_API_SECRET_KEY=CHANGE_ME      # SECRET: via Doppler `dev`
MAILJET_API_KEY=CHANGE_ME            # SECRET: via Doppler `dev`
MAILJET_API_SECRET=CHANGE_ME         # SECRET: via Doppler `dev`
RESEND_API_KEY=CHANGE_ME             # SECRET: via Doppler `dev`
# ZOHO_CLIENT_ID=                    # Zoho DocSign OAuth client id — set via Doppler `dev` when needed
# ZOHO_CLIENT_SECRET=                # SECRET: via Doppler `dev`
# DOJAH_APP_ID=                      # via Doppler `dev` (required when KYC_PROVIDER=DOJAH)
# DOJAH_PRIVATE_KEY=                 # SECRET: via Doppler `dev`
