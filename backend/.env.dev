# ==============================================================================
# Veriprops backend — DEV (deployed) environment (.env.dev)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `appodus_active_env=dev` — the shared, deployed development
# environment (dev.veriprops.ng), NOT a developer's machine (that is .env.local).
# Secrets are Doppler-managed (`dev` config) and injected as process env vars,
# which override this file. CHANGE_ME values are inert placeholders — the hygiene
# guard test (test/unit/app/config/test_env_hygiene.py) enforces this.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=dev
# FIXME(ops): confirm the deployed dev backend origin.
APP_DOMAIN=https://api.dev.veriprops.ng
SHOW_API=true                        # docs stay visible on dev
LOG_LEVEL=DEBUG
LOGGER_FILE_PATH=/tmp/appodus/logs
LOGGER_FILE=logs.txt
DISABLE_RATE_LIMITING=true           # QA convenience; MUST be false in prod
ENABLE_OUT_MESSAGING=false           # flip via Doppler when QA needs real delivery

# --- Brand --------------------------------------------------------------------
BRAND=veriprops
BRAND_SUPPORT_EMAIL=support@veriprops.ng
BRAND_SUPPORT_PHONE=

# --- Auth / JWT (real dev key via Doppler; policy enforced only in prod/staging) -
AUTHJWT_SECRET_KEY=CHANGE_ME
AUTHJWT_COOKIE_SECURE=true
ALLOW_AUTH_BYPASS=false
APPODUS_CLIENT_SECRET=CHANGE_ME
APPODUS_CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME

# --- OTP --------------------------------------------------------------------------
OTP_MODE=deterministic               # deterministic on dev so QA can log in without SMS

# --- Database (password via Doppler) ------------------------------------------------
ACTIVE_DB=POSTGRES
DB_SCHEME=postgresql+asyncpg
DB_SERVER=pg-2d5721ad-learningforge.b.aivencloud.com
DB_PORT=17637
DB_USER=avnadmin
DB_PASSWORD=CHANGE_ME
DB_NAME=veriprops_dev
DB_ENABLE_LOGS=false
DEPLOYMENT_IS_SERVERLESS=true        # Vercel dev deployment

# --- Email (Mailpit is not reachable from a deployment; delivery stays off until
# --- a real provider credential is set in Doppler and ENABLE_OUT_MESSAGING flips) -
EMAIL_FROM_ADDRESS=noreply@veriprops.dev
EMAIL_FROM_NAME=Veriprops

# --- Redis / KV ----------------------------------------------------------------------
REDIS_ENABLED=false

# --- CORS / OAuth origins ---------------------------------------------------------------
ALLOWED_ORIGINS=https://dev.veriprops.ng,http://localhost:3000
BACKEND_PUBLIC_ORIGIN=https://api.dev.veriprops.ng
OAUTH_CALLBACK_BASE_URL=https://dev.veriprops.ng
OAUTH_FRONTEND_ORIGINS=https://dev.veriprops.ng,http://localhost:3000

# --- OAuth providers (client ids are public; secrets via Doppler) -----------------------
GOOGLE_CLIENT_ID=477237984032-1dnvhncoq16mk3j2ebjque7gp9vapsqp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
FACEBOOK_APP_ID=mock_value
FACEBOOK_APP_SECRET=CHANGE_ME

# --- Payments (stub mode; sandbox keys via Doppler when exercising the gateway) ----------
ACTIVE_PAYMENT_METHOD=flutterwave
PAYMENT_STUB_MODE=true
FLUTTERWAVE_PUBLIC_KEY=CHANGE_ME
FLUTTERWAVE_SECRET_KEY=CHANGE_ME
FLUTTERWAVE_WEBHOOK_SECRET=CHANGE_ME
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
PAYSTACK_PUBLIC_KEY=CHANGE_ME
PAYSTACK_SECRET_KEY=CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Feature flags / stub modes -----------------------------------------------------------
DOCUMENT_STORAGE_STUB_MODE=true
REPORT_PDF_STUB_MODE=true
PHONE_VERIFICATION_ENABLED=false
LEGAL_OPINION_ENABLED=false
SCHEDULER_ENABLED=true
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Super admin seed (password via Doppler `dev`) ------------------------------------------
SUPER_ADMIN_EMAIL=admin@veriprops.dev
SUPER_ADMIN_PASSWORD=CHANGE_ME

# --- Third-party integration keys — ALL via Doppler -----------------------------------------
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
TERMII_API_KEY=CHANGE_ME
TERMII_API_SECRET_KEY=CHANGE_ME
MAILJET_API_KEY=CHANGE_ME
MAILJET_API_SECRET=CHANGE_ME
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# DOJAH_APP_ID=
# DOJAH_PRIVATE_KEY=
