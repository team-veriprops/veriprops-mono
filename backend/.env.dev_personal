# ==============================================================================
# Veriprops backend — DEV_PERSONAL environment (.env.dev_personal)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `APPODUS_ACTIVE_ENV=dev_personal` (the dev-server default). Fields map 1:1
# to the settings classes in appodus_utils/config/settings.py (AppodusBaseSettings)
# and app/config/settings.py (Settings) — names are case-insensitive, no prefix.
# Any field omitted here falls back to its in-code default.
#
# SECRETS ARE NEVER SET HERE. Real credentials live in Doppler and are injected
# as process env vars (`doppler run -- python veriprops.py`), which override this
# file. Keys below left at CHANGE_ME/empty are inert placeholders — the hygiene
# guard test (test/unit/app/config/test_env_hygiene.py) enforces this.
# A machine-specific override (e.g. a personal cloud DB) also belongs in Doppler,
# never in this committed file. See backend/.env.example for the full set of
# settable keys and their possible values.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=dev_personal             # dev_personal | dev | test | staging | prod
APP_DOMAIN=http://localhost:8000     # absolute URL of this backend
SHOW_API=true                        # true | false  (false hides /docs — use in prod)
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name within LOGGER_FILE_PATH
DISABLE_RATE_LIMITING=true           # true | false  (keep false in prod)
ENABLE_OUT_MESSAGING=false           # true | false  (true actually sends email/SMS — email -> Mailpit locally)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops                      # brand slug
BRAND_SUPPORT_EMAIL=support@veriprops.ng   # customer support address
BRAND_SUPPORT_PHONE=2347039018727                 # E.164 digits (no +), blank = none

# --- Auth / JWT ---------------------------------------------------------------
# The placeholder works locally (the strong-secret policy is enforced only for
# prod & staging); Doppler `dev_personal` supplies a real dev key so sessions survive.
AUTHJWT_SECRET_KEY=CHANGE_ME         # SECRET: HS256 signing key
AUTHJWT_COOKIE_SECURE=true           # true | false  (must stay true: __Host- cookies REQUIRE Secure)
# Note: Chrome treats http://localhost as a secure context and accepts Secure
# cookies there, so plain http works for dev; do not rename the cookie keys.

# --- OTP ------------------------------------------------------------------------
# deterministic => every OTP is TEST_OTP (654123); random => CSPRNG codes.
OTP_MODE=deterministic               # deterministic | random  (test=deterministic, prod=random — enforced)

# --- Database (docker-compose provides Postgres; on the host use localhost) -----
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg         # SQLAlchemy driver scheme
DB_SERVER=localhost                  # `postgres` inside compose
DB_PORT=5432                         # DB port (int)
DB_USER=postgres                     # DB user
DB_PASSWORD=CHANGE_ME                # SECRET: real value via Doppler `dev_personal`
DB_NAME=veriprops_local              # database name
DB_ENABLE_LOGS=false                 # true | false  (echoes SQL + bound params — enable only when debugging)

# --- Email (Mailpit — SMTP captured locally, no real mail sent) -----------------
SMTP_HOST=localhost                  # `mailpit` inside compose
SMTP_PORT=1025                       # 1025 (Mailpit) | 587 (STARTTLS) | 465 (TLS) | 25
SMTP_USE_TLS=false                   # true | false
EMAIL_FROM_ADDRESS=noreply@veriprops.dev   # valid TLD required (EmailStr rejects reserved .local)
EMAIL_FROM_NAME=Veriprops            # display name on outbound email

# --- Redis / KV (disabled: RedisUtils falls back to the SQL KV store) -----------
REDIS_ENABLED=false                  # true | false
# REDIS_HOST=localhost               # `redis` inside compose
# REDIS_PORT=6379                    # Redis port (int)
# REDIS_DB=0                         # Redis logical DB index

# --- CORS / OAuth origins --------------------------------------------------------
# Machine-specific dev LAN hosts belong in Doppler/your shell, never committed here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000   # comma-separated absolute origins (CORS allowlist)
BACKEND_PUBLIC_ORIGIN=http://localhost:8000     # public origin of this backend service
OAUTH_CALLBACK_BASE_URL=http://localhost:3000   # origin OAuth redirects land on (the frontend proxy)
OAUTH_FRONTEND_ORIGINS=http://localhost:3000    # comma-separated postMessage allowlist

# --- OAuth providers (inert mock sentinel — providers require non-empty values
# --- at bootstrap; real id+secret via Doppler when testing live OAuth) ------------
GOOGLE_CLIENT_ID=mock_value          # Google OAuth client id (public identifier)
GOOGLE_CLIENT_SECRET=mock_value      # SECRET (inert placeholder — via Doppler for live OAuth)
FACEBOOK_APP_ID=mock_value           # Facebook app id (public identifier)
FACEBOOK_APP_SECRET=mock_value       # SECRET (inert placeholder — via Doppler for live OAuth)
APPLE_TEAM_ID=mock_value             # Apple developer team id (public identifier)
APPLE_CLIENT_ID=mock_value           # Apple services id (public identifier)
APPLE_KEY_ID=mock_value              # Apple key id (for the client-secret JWT)
APPLE_PRIVATE_KEY=mock_value         # SECRET (inert placeholder — via Doppler for live OAuth)

# --- Payments (stub mode: no real gateway calls) ---------------------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack | stripe (stripe is enum-only — no live integration yet)
PAYMENT_STUB_MODE=true               # true | false  (MUST be false in prod)
# Sandbox gateway keys (needed only when PAYMENT_STUB_MODE=false) come from Doppler.
FLUTTERWAVE_PUBLIC_KEY=              # via Doppler (sandbox key)
FLUTTERWAVE_SECRET_KEY=              # SECRET: via Doppler
FLUTTERWAVE_WEBHOOK_SECRET=          # SECRET: via Doppler
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3   # Flutterwave API base URL
PAYSTACK_PUBLIC_KEY=                 # via Doppler (sandbox key)
PAYSTACK_SECRET_KEY=                 # SECRET: via Doppler
PAYSTACK_WEBHOOK_SECRET=             # SECRET: via Doppler
PAYSTACK_BASE_URL=https://api.paystack.co   # Paystack API base URL

# --- Feature flags / stub modes (keep stubs on locally) --------------------------
DOCUMENT_STORAGE_STUB_MODE=true      # true | false  (true = no real S3/R2 writes)
REPORT_PDF_STUB_MODE=true            # true | false  (false = real fpdf2 renderer)
PHONE_VERIFICATION_ENABLED=false     # true | false  (false = phone verified later, at the payment step)
LEGAL_OPINION_ENABLED=false          # true | false  (launch gate — never default-on)
SCHEDULER_ENABLED=true               # true | false  (disabled under test)
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Operational knobs (all have sensible in-code defaults; override as needed) ---
# OTP delivery / verification throttles
# OTP_CODE_TTL_SECONDS=600             # int seconds — sent-code validity window
# OTP_MAX_RESENDS=3                    # int — resends allowed within the lockout window
# OTP_RESEND_LOCKOUT_SECONDS=1800      # int seconds — resend-count window
# OTP_MAX_FAILURES=5                   # int — invalid attempts before a new code is required
# OTP_VERIFIED_MARKER_TTL_SECONDS=1800 # int seconds — post-verify "completed" marker lifetime
# PASSWORD_MIN_LENGTH=8                # int — server-side password minimum length
# OAuth provider caches / short-lived tokens
# OAUTH_STATE_TTL_SECONDS=600          # int seconds — anti-CSRF state validity
# OAUTH_JWKS_CACHE_SECONDS=300         # int seconds — provider JWKS cache lifetime
# OAUTH_CLIENT_SECRET_JWT_TTL_SECONDS=300  # int seconds — Apple client-secret JWT exp
# Drafts & abandonment lifetimes
# SIGNUP_DRAFT_TTL_DAYS=7              # int days — abandoned signup draft lifetime
# AGENT_APPLICATION_DRAFT_TTL_DAYS=30  # int days — abandoned agent-application draft lifetime
# VERIFICATION_ABANDONMENT_AGE_HOURS=24    # int hours — unpaid verification abandonment age
# IDEMPOTENCY_KEY_TTL_HOURS=24         # int hours — idempotency key retention window
# Server-Sent Events transport
# SSE_HEARTBEAT_SECONDS=25             # int seconds — SSE keep-alive interval
# SSE_QUEUE_MAXSIZE=100                # int — per-connection SSE event queue cap
# UI limits (frontend reads CHAT_MESSAGE_MAX_LENGTH via /config/public)
# CHAT_MESSAGE_MAX_LENGTH=2000         # int — max chat message length
# DASHBOARD_RECENT_LIMIT=5             # int — recent items on the customer/agent dashboard
# EVIDENCE_PREVIEW_LIMIT=3             # int — evidence thumbnails before "view all"
# ADMIN_DASHBOARD_RECENT_LIMIT=8       # int — recent items on the admin dashboard
# AUDIT_PACK_CONSENT_PAGE_SIZE=1000    # int — page size when paginating consent rows into an audit pack
# CHARGEBACK_PACK_PAGE_SIZE=500        # int — page size when paginating a chargeback evidence pack
# NOTE: admin-tunable business rules (SLA-at-risk horizon, payout SLA, dispute
# min-length, share-link expiry, analytics trend window) live in the system_config
# store (ConfigKey), edited via the admin API — NOT here.

# --- Super admin seed (deterministic local credential, gates a local DB only) ----
SUPER_ADMIN_EMAIL=admin@veriprops.dev     # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=Admin123!dev_personal   # SECRET-listed key, but a deterministic local-only credential — not a real secret

# --- Third-party integration keys (all Doppler-managed; blank = stub/mock mode) --
AWS_ACCESS_KEY=                      # SECRET: via Doppler
AWS_SECRET_ACCESS_KEY=               # SECRET: via Doppler
TERMII_API_KEY=                      # SECRET: via Doppler
TERMII_API_SECRET_KEY=               # SECRET: via Doppler
MAILJET_API_KEY=                     # SECRET: via Doppler
MAILJET_API_SECRET=                  # SECRET: via Doppler
# ZOHO_CLIENT_ID=                    # Zoho DocSign client id
# ZOHO_CLIENT_SECRET=                # SECRET: via Doppler
# DOJAH_APP_ID=                      # via Doppler (required when KYC_PROVIDER=DOJAH)
# DOJAH_PRIVATE_KEY=                 # SECRET: via Doppler
