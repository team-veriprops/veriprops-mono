# ==============================================================================
# Veriprops backend — environment template (.env.example)
# ------------------------------------------------------------------------------
# Copy to `.env.{env}` (local | dev | test | staging | prod) and fill in real
# CONFIG values. The active file is selected by `appodus_active_env` at import
# time. Keys map 1:1 to the settings classes (case-insensitive, no prefix); any
# key omitted here falls back to its in-code default.
#
# SECRETS ARE DOPPLER-MANAGED — never put a real credential in any committed
# env file. Doppler injects secrets as process env vars, which pydantic-settings
# gives precedence over these files. The credential keys are exactly
# `Settings.SECRET_ENV_KEYS` (app/config/settings.py); committed files must keep
# them absent/empty/CHANGE_ME — enforced by test_env_hygiene.py. This template
# documents every settable key (the drift-guard test fails when a new Settings
# field is missing here).
#
# Admin-tunable BUSINESS rules (dispute windows, commission clearance, SLA-at-risk
# horizon, payout SLA, share-link expiry, analytics trend window, …) are NOT env
# vars — they live in the system_config store (ConfigKey) and are edited via the
# admin API without a redeploy.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=local                    # local | dev | test | staging | prod
APP_DOMAIN=http://localhost:8000     # absolute URL of this backend
SHOW_API=true                        # true | false  (false hides /docs — use in prod)
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name
DISABLE_RATE_LIMITING=false          # true | false  (MUST be false in prod)
ENABLE_OUT_MESSAGING=false           # true | false  (true actually sends email/SMS)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops                      # brand slug
BRAND_SUPPORT_EMAIL=support@veriprops.ng   # customer support address
BRAND_SUPPORT_PHONE=                 # E.164 digits, no + (blank = none)

# --- Auth / JWT (SECRET — via Doppler) -----------------------------------------
# Prod/staging refuse to boot with a placeholder/leaked key or ALLOW_AUTH_BYPASS=true.
AUTHJWT_SECRET_KEY=CHANGE_ME         # SECRET: HS256 signing key
AUTHJWT_COOKIE_SECURE=true           # true | false  (must stay true — __Host- cookies require Secure)
# AUTHJWT_COOKIE_CSRF_PROTECT=true   # CSRF double-submit protection (keep on)
# AUTHJWT_COOKIE_SAMESITE=lax        # lax | strict | none
ALLOW_AUTH_BYPASS=false              # true | false  (MUST be false in prod/staging)
# AUTH_LOCKOUT_THRESHOLD=7           # failed logins before lockout
# AUTH_LOCKOUT_MINUTES=15            # lockout duration
# ACCESS_TOKEN_TTL_SECONDS=900       # access-token lifetime
# REFRESH_TOKEN_TTL_SECONDS=2592000  # refresh-token lifetime (30 days)
# PASSWORD_RESET_TTL_SECONDS=3600    # reset-link validity
# PASSWORD_MIN_LENGTH=8              # server-side password minimum length
# AUTH_URL_PATH=/auth                # auth router mount path
# CACHE_DATA_EXPIRES_SECONDS=691200  # default KV/cache TTL

# --- Appodus service client (SECRETS via Doppler) --------------------------------
APPODUS_SERVICES_URL=                # base URL of the Appodus services (env-specific)
APPODUS_CLIENT_SECRET=CHANGE_ME      # SECRET
APPODUS_CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME  # SECRET
# APPODUS_CLIENT_ID=                 # client id (public identifier)
# APPODUS_CLIENT_REQUEST_EXPIRES_SECONDS=300

# --- OTP ---------------------------------------------------------------------------
OTP_MODE=deterministic               # deterministic | random  (test=deterministic, prod=random)
# OTP_CODE_TTL_SECONDS=600           # sent-code validity window
# OTP_MAX_RESENDS=3
# OTP_RESEND_LOCKOUT_SECONDS=1800
# OTP_MAX_FAILURES=5
# OTP_VERIFIED_MARKER_TTL_SECONDS=1800
# OTP_TOKEN_EXPIRE_SECONDS=300       # legacy OTP token expiry
# EMAIL_OTP_TOKEN_EXPIRE_SECONDS=1800

# --- OAuth (state / cache lifetimes; provider creds via Doppler) ---------------------
# OAUTH_STATE_TTL_SECONDS=600
# OAUTH_JWKS_CACHE_SECONDS=300
# OAUTH_CLIENT_SECRET_JWT_TTL_SECONDS=300
# SOCIAL_LOGIN_CALLBACK_PATH=/oauth
# SOCIAL_LOGIN_SUCCESS_PATH=/auth/oauth/redirect
# GOOGLE_AUTH_BASE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_CLIENT_ID=mock_value          # Google OAuth client id (public identifier)
GOOGLE_CLIENT_SECRET=                # SECRET: via Doppler
# FACEBOOK_AUTH_BASE_URL=https://www.facebook.com/v22.0/dialog/oauth
FACEBOOK_APP_ID=mock_value           # Facebook app id (public identifier)
FACEBOOK_APP_SECRET=                 # SECRET: via Doppler
# APPLE_AUTH_BASE_URL=               # Apple authorize endpoint
# APPLE_TEAM_ID=                     # Apple team id
# APPLE_CLIENT_ID=                   # Apple services id
# APPLE_KEY_ID=                      # Apple key id
# APPLE_PRIVATE_KEY=                 # SECRET: via Doppler

# --- Database (password via Doppler) --------------------------------------------------
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg         # driver scheme
DB_SERVER=localhost                  # DB host
DB_PORT=5432                         # DB port
DB_USER=postgres                     # DB user
DB_PASSWORD=CHANGE_ME                # SECRET: via Doppler
DB_NAME=veriprops_local              # database name
DB_ENABLE_LOGS=false                 # true | false  (echoes SQL + bound params — false in prod)
DEPLOYMENT_IS_SERVERLESS=false       # true | false  (true = NullPool for serverless)
# DB_ADDITIONAL_CONFIG=              # extra query-string args on the DB URL
# DB_ENABLE_LOG_POOL=true            # pool diagnostics logging

# --- Email (Mailpit in dev/test; real provider creds via Doppler in staging/prod) -----
SMTP_HOST=localhost                  # SMTP host
SMTP_PORT=1025                       # 1025 (Mailpit) | 587 | 465 | 25
SMTP_USE_TLS=false                   # true | false
SMTP_TIMEOUT_SECONDS=15              # socket timeout — a dead SMTP host must fail, not hang
# SMTP_USERNAME=                     # SMTP auth user (unused with Mailpit)
# SMTP_PASSWORD=                     # SECRET: via Doppler
EMAIL_FROM_ADDRESS=noreply@veriprops.dev   # valid TLD required
EMAIL_FROM_NAME=Veriprops

# --- Redis / KV (optional; SQL KV fallback when disabled) ------------------------------
REDIS_ENABLED=false                  # true | false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=                    # via Doppler when the instance requires auth
# REDIS_PASSWORD=                    # SECRET: via Doppler
# REDIS_THREAD_SLEEP_TIME=0.01

# --- CORS / OAuth origins ----------------------------------------------------------------
# Add machine-specific dev LAN hosts via Doppler/shell, never in committed files.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BACKEND_PUBLIC_ORIGIN=http://localhost:8000
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
OAUTH_FRONTEND_ORIGINS=http://localhost:3000

# --- Payments (gateway keys via Doppler) ---------------------------------------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack | stripe
PAYMENT_STUB_MODE=true               # true | false  (MUST be false in prod)
# FLUTTERWAVE_PUBLIC_KEY=            # via Doppler
# FLUTTERWAVE_SECRET_KEY=            # SECRET: via Doppler
# FLUTTERWAVE_WEBHOOK_SECRET=        # SECRET: via Doppler
# FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
# FLUTTERWAVE_REDIRECT_URL=webhooks/flutterwave/redirect
# PAYSTACK_PUBLIC_KEY=               # via Doppler
# PAYSTACK_SECRET_KEY=               # SECRET: via Doppler
# PAYSTACK_WEBHOOK_SECRET=           # SECRET: via Doppler
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYMENT_FRONTEND_REDIRECT_PATH=/payment/redirect

# --- Feature flags / stub modes -------------------------------------------------------------
DOCUMENT_STORAGE_STUB_MODE=true      # true | false
REPORT_PDF_STUB_MODE=true            # true | false
PHONE_VERIFICATION_ENABLED=false     # true | false
LEGAL_OPINION_ENABLED=false          # true | false  (launch gate — never default-on)
SCHEDULER_ENABLED=true               # true | false  (disabled under test)
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES
# KYC_SELFIE_REVIEW_THRESHOLD=80     # selfie score below this routes to admin review

# --- Scheduler / task sweeps -----------------------------------------------------------------
# SCHEDULER_SWEEP_INTERVAL_SECONDS=900
# AUTO_ASSIGNMENT_ENABLED=false      # broadcast tasks to the open pool at PAID
# AGENT_MAX_ACTIVE_TASKS=5           # capacity cap enforced on assign/accept
# TASK_NO_SHOW_TIMEOUT_HOURS=12      # manual-assign accept deadline
# TASK_POOL_TIMEOUT_HOURS=24         # broadcast starvation timeout
# REMOTE_JOB_BONUS_MINOR=0           # optional flat bonus on aging pool tasks (kobo)
# AGENT_COMMISSION_SHARE=0.40        # agents' share of the verification price
# ADMIN_INVITE_TTL_HOURS=72

# --- Pricing / reports -------------------------------------------------------------------------
# PRICE_LOCK_TTL_HOURS=24
# PRICING_FX_CACHE_SECONDS=300
# PRICING_FX_STALE_AFTER_SECONDS=1800
# PUBLIC_APP_BASE_URL=https://veriprops.ng   # base the report QR deep-links to
# REPORT_BRAND_NAME=Veriprops

# --- Real-time / limits (optional overrides; sensible defaults in code) --------------------------
# SSE_HEARTBEAT_SECONDS=25
# SSE_QUEUE_MAXSIZE=100
# CHAT_MESSAGE_MAX_LENGTH=2000       # frontend reads this via /config/public
# DASHBOARD_RECENT_LIMIT=5
# EVIDENCE_PREVIEW_LIMIT=3
# ADMIN_DASHBOARD_RECENT_LIMIT=8
# AUDIT_PACK_CONSENT_PAGE_SIZE=1000
# CHARGEBACK_PACK_PAGE_SIZE=500
# SIGNUP_DRAFT_TTL_DAYS=7
# AGENT_APPLICATION_DRAFT_TTL_DAYS=30
# VERIFICATION_ABANDONMENT_AGE_HOURS=24
# IDEMPOTENCY_KEY_TTL_HOURS=24

# --- Messaging pipeline ----------------------------------------------------------------------------
MESSAGING_RETRY_INTERVALS_SECONDS=[60,300,900]  # JSON list — backoff ladder; threshold = length
# MESSAGING_RPS_LIMIT=20
# MESSAGING_BULK_CONCURRENCY=10
# MESSAGING_PRIORITY=2
# MESSAGING_SANDBOX_MODE=false
# MESSAGING_HEADERS={}               # JSON object
# MESSAGING_CATEGORIES=[]            # JSON list
# MESSAGE_TEMPLATE_DIR=resources/templates
# ACTIVE_TEMPLATING_ENGINE=jinja2
# TEMPLATE_ENGINE=jinja2
# SMS_SENDER_ID=veriprops
# SMS_TTL=25000

# --- Super admin seed (password via Doppler) ----------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@veriprops.dev   # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=CHANGE_ME       # SECRET: via Doppler (deterministic seed value ok in local/test)

# --- File storage (AWS creds via Doppler) ------------------------------------------------------------
# AWS_ACCESS_KEY=                    # SECRET: via Doppler
# AWS_SECRET_ACCESS_KEY=             # SECRET: via Doppler
# AWS_REGION_NAME=us-east-1
# AWS_S3_BUCKET=veriprops-documents
# AWS_S3_PLATFORM_NAME=S3            # S3 | R2 | STUB
# AWS_S3_PRESIGNED_URL_EXPIRES=900

# --- SMS / email / push provider credentials — ALL via Doppler ----------------------------------------
# TERMII_API=https://v3.api.termii.com/api
# TERMII_API_KEY=                    # SECRET
# TERMII_API_SECRET_KEY=             # SECRET
# TWILIO_ACCOUNT_SID=                # account identifier
# TWILIO_AUTH_TOKEN=                 # SECRET
# TWILIO_PHONE_NUMBER=
# SENDGRID_API_KEY=                  # SECRET
# SENDGRID_API_SECRET=               # SECRET
# MAILJET_API=https://api.mailjet.com
# MAILJET_API_KEY=                   # SECRET
# MAILJET_API_SECRET=                # SECRET
# FIREBASE_CREDENTIALS_PATH=         # service-account JSON path (file itself git-ignored)
# WEB_PUSH_PUBLIC_KEY=               # VAPID public key
# WEB_PUSH_PRIVATE_KEY=              # SECRET: VAPID private key
# WEB_PUSH_CONTACT_EMAIL=notifications@example.com

# --- WhatsApp (Meta Business API — secrets via Doppler) -------------------------------------------------
# WHATSAPP_API_URL=https://graph.facebook.com/v22.0
# WHATSAPP_PHONE_NUMBER_ID=          # public identifier
# WHATSAPP_BUSINESS_ACCOUNT_ID=      # public identifier
# WHATSAPP_APP_SECRET_KEY=           # SECRET
# WHATSAPP_BUSINESS_WEBHOOK_VERIFY_TOKEN=  # SECRET
# WHATSAPP_BUSINESS_ACCESS_TOKEN=    # SECRET

# --- Zoho DocSign / Google Drive (secrets via Doppler) ---------------------------------------------------
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=                # SECRET
# ZOHO_REFRESH_TOKEN=                # SECRET
# ZOHO_WEBHOOK_SECRET=               # SECRET
# ZOHO_DOC_SIGN_DATA_CENTER=https://sign.zoho.com
# GOOGLE_WEBHOOK_SECRET=             # SECRET
# GOOGLE_WEBHOOK_NOTIFICATION_TTL=86400
# GOOGLE_DOC_CHANGE_UPDATE_WINDOW=86400
# GOOGLE_SERVICE_ACCOUNT_FILE=       # service-account JSON path (file itself git-ignored)
# GOOGLE_DOC_PARENT_CONTRACT_FOLDER_ID=
# GOOGLE_DOC_PROPERTY_CONTRACT_FOLDER_ID=

# --- KYC (Dojah — secrets via Doppler; required only when KYC_PROVIDER=DOJAH) -----------------------------
# DOJAH_APP_ID=                      # via Doppler
# DOJAH_PRIVATE_KEY=                 # SECRET
# DOJAH_WEBHOOK_SECRET=              # SECRET

# --- Webhooks ----------------------------------------------------------------------------------------------
# WEBHOOK_PATH=/webhooks             # webhook router mount path
