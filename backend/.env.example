# ==============================================================================
# Veriprops backend — environment template (.env.example)
# ------------------------------------------------------------------------------
# Copy to `.env.{env}` (dev_personal | dev | test | staging | prod) and fill in real
# CONFIG values. The active file is selected by `APPODUS_ACTIVE_ENV` at import
# time. Keys map 1:1 to the settings classes (case-insensitive, no prefix); any
# key omitted here falls back to its in-code default.
#
# SECRETS ARE DOPPLER-MANAGED — never put a real credential in any committed
# env file. Doppler injects secrets as process env vars, which pydantic-settings
# gives precedence over these files. The credential keys are exactly
# `Settings.SECRET_ENV_KEYS` (app/config/settings.py); committed files must keep
# them absent/empty/CHANGE_ME — enforced by test_env_hygiene.py. This template
# documents every settable key (the drift-guard test fails when a new Settings
# field is missing here).
#
# Admin-tunable BUSINESS rules (dispute windows, commission clearance, SLA-at-risk
# horizon, payout SLA, share-link expiry, analytics trend window, …) are NOT env
# vars — they live in the system_config store (ConfigKey) and are edited via the
# admin API without a redeploy.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=dev_personal             # dev_personal | dev | test | staging | prod
APP_DOMAIN=http://localhost:8000     # absolute URL of this backend
SHOW_API=true                        # true | false  (false hides /docs — use in prod)
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name (within LOGGER_FILE_PATH)
DISABLE_RATE_LIMITING=false          # true | false  (MUST be false in prod)
ENABLE_OUT_MESSAGING=false           # true | false  (true actually sends email/SMS)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops                      # brand slug (used in log lines, message templates)
BRAND_SUPPORT_EMAIL=support@veriprops.ng   # customer support address (any valid email)
BRAND_SUPPORT_PHONE=                 # E.164 digits, no + (blank = none)

# --- Auth / JWT (SECRET — via Doppler) -----------------------------------------
# Prod/staging refuse to boot with a placeholder/leaked key.
AUTHJWT_SECRET_KEY=CHANGE_ME         # SECRET: HS256 signing key — any non-placeholder string in prod/staging
AUTHJWT_COOKIE_SECURE=true           # true | false  (must stay true — __Host- cookies require Secure)
# AUTHJWT_COOKIE_CSRF_PROTECT=true   # true | false — CSRF double-submit protection (keep on)
# AUTHJWT_COOKIE_SAMESITE=lax        # lax | strict | none
# AUTH_LOCKOUT_THRESHOLD=7           # int — failed logins before lockout
# AUTH_LOCKOUT_MINUTES=15            # int — lockout duration in minutes
# ACCESS_TOKEN_TTL_SECONDS=900       # int seconds — access-token lifetime (default 15 min)
# REFRESH_TOKEN_TTL_SECONDS=2592000  # int seconds — refresh-token lifetime (default 30 days)
# PASSWORD_RESET_TTL_SECONDS=3600    # int seconds — reset-link validity (default 1 hr)
# PASSWORD_MIN_LENGTH=8              # int — server-side password minimum length
# AUTH_URL_PATH=/auth                # auth router mount path
# CACHE_DATA_EXPIRES_SECONDS=691200  # int seconds — default KV/cache TTL (default 8 days)

# --- OTP ---------------------------------------------------------------------------
# deterministic => every OTP is TEST_OTP (654123); random => CSPRNG codes.
OTP_MODE=deterministic               # deterministic | random  (test REQUIRES deterministic, prod REQUIRES random — enforced at boot)
# OTP_CODE_TTL_SECONDS=600           # int seconds — sent-code validity window (default 10 min)
# OTP_MAX_RESENDS=3                 # int — resends allowed before lockout
# OTP_RESEND_LOCKOUT_SECONDS=1800   # int seconds — resend lockout duration (default 30 min)
# OTP_MAX_FAILURES=5                # int — verify failures allowed before lockout
# OTP_VERIFIED_MARKER_TTL_SECONDS=1800   # int seconds — "verified" marker validity (default 30 min)
# OTP_TOKEN_EXPIRE_SECONDS=300       # int seconds — legacy OTP token expiry (default 5 min)
# EMAIL_OTP_TOKEN_EXPIRE_SECONDS=1800    # int seconds — email OTP token expiry (default 30 min)

# --- OAuth (state / cache lifetimes; provider creds via Doppler) ---------------------
# OAUTH_STATE_TTL_SECONDS=600                    # int seconds — OAuth state param validity
# OAUTH_JWKS_CACHE_SECONDS=300                   # int seconds — provider JWKS cache TTL
# OAUTH_CLIENT_SECRET_JWT_TTL_SECONDS=300         # int seconds — client-secret JWT (Apple) TTL
# SOCIAL_LOGIN_CALLBACK_PATH=/oauth              # OAuth callback router mount path
# SOCIAL_LOGIN_SUCCESS_PATH=/auth/oauth/redirect # path the frontend lands on after success
# GOOGLE_AUTH_BASE_URL=https://accounts.google.com/o/oauth2/v2/auth   # Google authorize endpoint
GOOGLE_CLIENT_ID=mock_value          # Google OAuth client id (public identifier)
GOOGLE_CLIENT_SECRET=                # SECRET: via Doppler
# FACEBOOK_AUTH_BASE_URL=https://www.facebook.com/v22.0/dialog/oauth   # Facebook authorize endpoint
FACEBOOK_APP_ID=mock_value           # Facebook app id (public identifier)
FACEBOOK_APP_SECRET=                 # SECRET: via Doppler
# APPLE_AUTH_BASE_URL=https://appleid.apple.com/auth/authorize   # Apple authorize endpoint
APPLE_TEAM_ID=mock_value             # Apple developer team id (public identifier)
APPLE_CLIENT_ID=mock_value           # Apple services id (public identifier)
APPLE_KEY_ID=mock_value              # Apple key id (for the client-secret JWT)
APPLE_PRIVATE_KEY=                   # SECRET: via Doppler (Apple Sign-In private key, PEM)

# --- Database (password via Doppler) --------------------------------------------------
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg         # SQLAlchemy driver scheme (e.g. postgresql+asyncpg)
DB_SERVER=localhost                  # DB host
DB_PORT=5432                         # DB port (int)
DB_USER=postgres                     # DB user
DB_PASSWORD=CHANGE_ME                # SECRET: via Doppler
DB_NAME=veriprops_local              # database name
DB_ENABLE_LOGS=false                 # true | false  (echoes SQL + bound params — false in prod)
DEPLOYMENT_IS_SERVERLESS=false       # true | false  (true = NullPool for serverless; false = pooled engine)
# DB_ADDITIONAL_CONFIG=              # extra query-string args appended to the DB URL
# DB_ENABLE_LOG_POOL=true            # true | false — pool diagnostics logging

# --- Email (Mailpit in dev/test; real provider creds via Doppler in staging/prod) -----
SMTP_HOST=localhost                  # SMTP host
SMTP_PORT=1025                       # 1025 (Mailpit) | 587 (STARTTLS) | 465 (TLS) | 25
SMTP_USE_TLS=false                   # true | false
SMTP_TIMEOUT_SECONDS=15              # int seconds — socket timeout (a dead SMTP host must fail, not hang)
# SMTP_USERNAME=                     # SMTP auth user (unused with Mailpit)
# SMTP_PASSWORD=                     # SECRET: via Doppler
EMAIL_FROM_ADDRESS=noreply@veriprops.dev   # valid TLD required (EmailStr rejects reserved TLDs like .local)
EMAIL_FROM_NAME=Veriprops            # display name on outbound email

# --- Redis / KV (optional; SQL KV fallback when disabled) ------------------------------
REDIS_ENABLED=false                  # true | false  (false = RedisUtils falls back to the SQL KV store)
# REDIS_HOST=localhost               # Redis host
# REDIS_PORT=6379                    # Redis port (int)
# REDIS_DB=0                         # Redis logical DB index
# REDIS_USERNAME=                    # via Doppler when the instance requires auth
# REDIS_PASSWORD=                    # SECRET: via Doppler
# REDIS_THREAD_SLEEP_TIME=0.01       # float seconds — poll interval for blocking Redis ops

# --- CORS / OAuth origins ----------------------------------------------------------------
# Add machine-specific dev LAN hosts via Doppler/shell, never in committed files.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000   # comma-separated absolute origins (CORS allowlist)
BACKEND_PUBLIC_ORIGIN=http://localhost:8000                   # public origin of this backend service
OAUTH_CALLBACK_BASE_URL=http://localhost:3000                 # origin OAuth redirects land on (falls back to BACKEND_PUBLIC_ORIGIN if blank)
OAUTH_FRONTEND_ORIGINS=http://localhost:3000                  # comma-separated postMessage allowlist for the OAuth popup flow

# --- Edge auth (Cloudflare proxy enforcement) ----------------------------------------------
# The Cloudflare Transform Rule injects `x-edge-auth: <EDGE_AUTH_SECRET>` on every proxied
# request; when the secret is set, requests without it are rejected (closes the *.vercel.app /
# direct-origin bypass). Blank/CHANGE_ME disables the check — local/test/e2e run open.
# EDGE_AUTH_SECRET=                   # SECRET: via Doppler (same value in the Cloudflare rule and BOTH apps' Doppler configs)
# EDGE_AUTH_HEADER=x-edge-auth        # request header the Cloudflare Transform Rule sets

# --- Payments (gateway keys via Doppler) ---------------------------------------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack | stripe (stripe is enum-only — no live integration yet)
PAYMENT_STUB_MODE=true               # true | false  (MUST be false in prod — false requires real gateway webhooks)
# FLUTTERWAVE_PUBLIC_KEY=            # via Doppler
# FLUTTERWAVE_SECRET_KEY=            # SECRET: via Doppler
# FLUTTERWAVE_WEBHOOK_SECRET=        # SECRET: via Doppler
# FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3   # Flutterwave API base URL
# FLUTTERWAVE_REDIRECT_URL=webhooks/flutterwave/redirect   # post-payment redirect path
# PAYSTACK_PUBLIC_KEY=               # via Doppler
# PAYSTACK_SECRET_KEY=               # SECRET: via Doppler
# PAYSTACK_WEBHOOK_SECRET=           # SECRET: via Doppler
# PAYSTACK_BASE_URL=https://api.paystack.co   # Paystack API base URL
# PAYMENT_FRONTEND_REDIRECT_PATH=/payment/redirect   # frontend path after gateway redirect

# --- Feature flags / stub modes -------------------------------------------------------------
DOCUMENT_STORAGE_STUB_MODE=true      # true | false  (true = no real S3/R2 writes)
REPORT_PDF_STUB_MODE=true            # true | false  (false = real fpdf2 renderer)
PHONE_VERIFICATION_ENABLED=false     # true | false  (false = phone verified later, at the payment step)
LEGAL_OPINION_ENABLED=false          # true | false  (launch gate — never default-on)
SCHEDULER_ENABLED=true               # true | false  (disabled under test — sweeps invoked directly by tests)
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES
# KYC_SELFIE_REVIEW_THRESHOLD=80     # int 0-100 — selfie score below this routes to admin review

# --- Scheduler / task sweeps -----------------------------------------------------------------
# SCHEDULER_SWEEP_INTERVAL_SECONDS=900   # int seconds — how often background sweeps run (default 15 min)
# AUTO_ASSIGNMENT_ENABLED=false      # true | false — broadcast tasks to the open pool at PAID
# AGENT_MAX_ACTIVE_TASKS=5           # int — capacity cap enforced on assign/accept
# TASK_NO_SHOW_TIMEOUT_HOURS=12      # int hours — manual-assign accept deadline
# TASK_POOL_TIMEOUT_HOURS=24         # int hours — broadcast starvation timeout
# REMOTE_JOB_BONUS_MINOR=0           # int — optional flat bonus on aging pool tasks (kobo)
# AGENT_COMMISSION_SHARE=0.40        # float 0-1 — agents' share of the verification price
# ADMIN_INVITE_TTL_HOURS=72          # int hours — admin invite link validity

# --- Pricing / reports -------------------------------------------------------------------------
# PRICE_LOCK_TTL_HOURS=24            # int hours — how long a quoted price stays locked
# PRICING_FX_CACHE_SECONDS=300       # int seconds — FX rate cache TTL
# PRICING_FX_STALE_AFTER_SECONDS=1800   # int seconds — FX rate considered stale after this age
# PUBLIC_APP_BASE_URL=https://veriprops.ng   # base the report QR deep-links to (any absolute URL)
# REPORT_BRAND_NAME=Veriprops        # brand name printed on generated reports

# --- Real-time / limits (optional overrides; sensible defaults in code) --------------------------
# SSE_HEARTBEAT_SECONDS=25           # int seconds — SSE keep-alive interval
# SSE_QUEUE_MAXSIZE=100              # int — per-connection SSE event queue cap
# CHAT_MESSAGE_MAX_LENGTH=2000       # int — max chat message length; frontend reads this via /config/public
# DASHBOARD_RECENT_LIMIT=5           # int — recent items shown on the customer/agent dashboard
# EVIDENCE_PREVIEW_LIMIT=3           # int — evidence thumbnails shown before "view all"
# ADMIN_DASHBOARD_RECENT_LIMIT=8     # int — recent items shown on the admin dashboard
# AUDIT_PACK_CONSENT_PAGE_SIZE=1000  # int — page size when paginating consent rows into an audit pack
# CHARGEBACK_PACK_PAGE_SIZE=500      # int — page size when paginating a chargeback evidence pack
# SIGNUP_DRAFT_TTL_DAYS=7            # int days — abandoned signup draft lifetime
# AGENT_APPLICATION_DRAFT_TTL_DAYS=30    # int days — abandoned agent-application draft lifetime
# VERIFICATION_ABANDONMENT_AGE_HOURS=24  # int hours — age at which an unpaid verification is considered abandoned
# IDEMPOTENCY_KEY_TTL_HOURS=24       # int hours — idempotency key retention window

# --- Messaging pipeline ----------------------------------------------------------------------------
MESSAGING_RETRY_INTERVALS_SECONDS=[60,300,900]  # JSON list of ints — backoff ladder; threshold = list length
# MESSAGING_RPS_LIMIT=20             # int — outbound requests/sec cap
# MESSAGING_BULK_CONCURRENCY=10      # int — concurrent sends for send_bulk
# MESSAGING_PRIORITY=2               # int — default provider dispatch priority
# MESSAGING_SANDBOX_MODE=false       # true | false — provider sandbox/test mode
# MESSAGING_HEADERS={}               # JSON object — extra headers sent to the provider API
# MESSAGING_CATEGORIES=[]            # JSON list of strings — provider-specific message categories
# ACTIVE_TEMPLATING_ENGINE=jinja2    # jinja2 (only member today)
# TEMPLATE_ENGINE=jinja2             # jinja2 (only member today) — separate from ACTIVE_TEMPLATING_ENGINE
# SMS_SENDER_ID=veriprops            # SMS sender id/name shown to recipients
# SMS_TTL=25000                      # int — provider-side SMS validity window (ms, provider-specific)

# --- Super admin seed (password via Doppler) ----------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@veriprops.dev   # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=CHANGE_ME       # SECRET: via Doppler (deterministic seed value ok in local/test)

# --- File storage (AWS creds via Doppler) ------------------------------------------------------------
# AWS_ACCESS_KEY=                    # SECRET: via Doppler
# AWS_SECRET_ACCESS_KEY=             # SECRET: via Doppler
# AWS_REGION_NAME=us-east-1          # AWS region
# AWS_S3_BUCKET=veriprops-documents  # S3 bucket name
# AWS_S3_PLATFORM_NAME=S3            # S3 | R2 | STUB
# AWS_S3_PRESIGNED_URL_EXPIRES=900   # int seconds — presigned URL validity (default 15 min)

# --- SMS / email / push provider credentials — ALL via Doppler ----------------------------------------
# TERMII_API=https://v3.api.termii.com/api   # Termii API base URL
# TERMII_API_KEY=                    # SECRET
# TERMII_API_SECRET_KEY=             # SECRET
# TWILIO_ACCOUNT_SID=                # account identifier
# TWILIO_AUTH_TOKEN=                 # SECRET
# TWILIO_PHONE_NUMBER=               # sending number, E.164 format
# MAILJET_API=https://api.mailjet.com   # Mailjet API base URL
# MAILJET_API_KEY=                   # SECRET
# MAILJET_API_SECRET=                # SECRET
# RESEND_API=https://api.resend.com  # Resend API base URL
# RESEND_API_KEY=                    # SECRET
# FIREBASE_CREDENTIALS_PATH=         # service-account JSON path (file itself git-ignored)
# WEB_PUSH_PUBLIC_KEY=               # VAPID public key
# WEB_PUSH_PRIVATE_KEY=              # SECRET: VAPID private key
# WEB_PUSH_CONTACT_EMAIL=notifications@example.com   # VAPID contact email

# --- WhatsApp (Meta Business API — secrets via Doppler) -------------------------------------------------
WHATSAPP_PROVIDER=stub                # stub | meta  (test REQUIRES stub, prod REQUIRES meta — enforced at boot)
# WHATSAPP_API_URL=https://graph.facebook.com/v22.0   # Meta Graph API base URL
# WHATSAPP_PHONE_NUMBER_ID=          # public identifier
# WHATSAPP_BUSINESS_ACCOUNT_ID=      # public identifier
# WHATSAPP_APP_SECRET_KEY=           # SECRET
# WHATSAPP_BUSINESS_WEBHOOK_VERIFY_TOKEN=  # SECRET
# WHATSAPP_BUSINESS_ACCESS_TOKEN=    # SECRET
# WHATSAPP_OFFICIAL_NUMBER=2349167624347  # PRD §7.1.2 official number, digits only (wa.me)
# WHATSAPP_WIDGET_ENABLED=True       # §7.4.1 floating chat widget kill switch

# --- Zoho DocSign / Google Drive (secrets via Doppler) ---------------------------------------------------
# ZOHO_CLIENT_ID=                    # Zoho DocSign OAuth client id
# ZOHO_CLIENT_SECRET=                # SECRET
# ZOHO_REFRESH_TOKEN=                # SECRET
# ZOHO_WEBHOOK_SECRET=               # SECRET
# ZOHO_DOC_SIGN_DATA_CENTER=https://sign.zoho.com   # Zoho data-center base URL
# GOOGLE_WEBHOOK_SECRET=             # SECRET
# GOOGLE_WEBHOOK_NOTIFICATION_TTL=86400   # int seconds — Google Drive push-notification channel TTL (default 1 day)
# GOOGLE_DOC_CHANGE_UPDATE_WINDOW=86400   # int seconds — change-detection lookback window (default 1 day)
# GOOGLE_SERVICE_ACCOUNT_FILE=       # service-account JSON path (file itself git-ignored)
# GOOGLE_DOC_PARENT_CONTRACT_FOLDER_ID=       # Google Drive folder id
# GOOGLE_DOC_PROPERTY_CONTRACT_FOLDER_ID=     # Google Drive folder id

# --- KYC (Dojah — secrets via Doppler; required only when KYC_PROVIDER=DOJAH) -----------------------------
# DOJAH_APP_ID=                      # via Doppler
# DOJAH_PRIVATE_KEY=                 # SECRET
# DOJAH_WEBHOOK_SECRET=              # SECRET

# --- Webhooks ----------------------------------------------------------------------------------------------
# WEBHOOK_PATH=/webhooks             # webhook router mount path
