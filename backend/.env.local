# ==============================================================================
# Veriprops backend — LOCAL environment (.env.local)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `appodus_active_env=local` (the dev-server default). Fields map 1:1
# to the settings classes in appodus_utils/config/settings.py (AppodusBaseSettings)
# and app/config/settings.py (Settings) — names are case-insensitive, no prefix.
# Any field omitted here falls back to its in-code default.
#
# SECRETS ARE NEVER SET HERE. Real credentials live in Doppler and are injected
# as process env vars (`doppler run -- python veriprops.py`), which override this
# file. Keys below left at CHANGE_ME/empty are inert placeholders — the hygiene
# guard test (test/unit/app/config/test_env_hygiene.py) enforces this.
# A machine-specific override (e.g. a personal cloud DB) also belongs in Doppler,
# never in this committed file.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=local                    # local | dev | test | staging | prod
APP_DOMAIN=http://localhost:8000     # absolute URL of this backend
SHOW_API=true                        # false hides /docs — use in prod
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name within LOGGER_FILE_PATH
DISABLE_RATE_LIMITING=true           # keep false in prod
ENABLE_OUT_MESSAGING=false           # true actually sends email/SMS (email -> Mailpit locally)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops
BRAND_SUPPORT_EMAIL=support@veriprops.ng
BRAND_SUPPORT_PHONE=                 # E.164 digits (no +), blank = none

# --- Auth / JWT ---------------------------------------------------------------
# The placeholder works locally (the strong-secret policy is enforced only for
# prod & staging); Doppler `local` supplies a real dev key so sessions survive.
AUTHJWT_SECRET_KEY=CHANGE_ME
AUTHJWT_COOKIE_SECURE=true           # must stay true: __Host- cookies REQUIRE Secure.
ALLOW_AUTH_BYPASS=false              # MUST be false in prod/staging — boot fails otherwise
# Note: Chrome treats http://localhost as a secure context and accepts Secure
# cookies there, so plain http works for dev; do not rename the cookie keys.

# --- Appodus service client ----------------------------------------------------
APPODUS_CLIENT_SECRET=CHANGE_ME
APPODUS_CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME

# --- OTP ------------------------------------------------------------------------
# deterministic => every OTP is TEST_OTP (654123); random => CSPRNG codes.
OTP_MODE=deterministic               # test=deterministic, prod=random (enforced)

# --- Database (docker-compose provides Postgres; on the host use localhost) -----
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg
DB_SERVER=localhost                  # `postgres` inside compose
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME                # real value via Doppler `local`
DB_NAME=veriprops_local
DB_ENABLE_LOGS=false                 # echoes SQL + bound params — enable only when debugging
DEPLOYMENT_IS_SERVERLESS=false       # true = NullPool for Vercel; false = pooled server

# --- Email (Mailpit — SMTP captured locally, no real mail sent) -----------------
SMTP_HOST=localhost                  # `mailpit` inside compose
SMTP_PORT=1025                       # 1025 (Mailpit) | 587 (STARTTLS) | 465 (TLS) | 25
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=noreply@veriprops.dev   # valid TLD required (EmailStr rejects reserved .local)
EMAIL_FROM_NAME=Veriprops

# --- Redis / KV (disabled: RedisUtils falls back to the SQL KV store) -----------
REDIS_ENABLED=false
# REDIS_HOST=localhost               # `redis` inside compose
# REDIS_PORT=6379
# REDIS_DB=0

# --- CORS / OAuth origins --------------------------------------------------------
# Machine-specific dev LAN hosts belong in Doppler/your shell, never committed here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BACKEND_PUBLIC_ORIGIN=http://localhost:8000
OAUTH_CALLBACK_BASE_URL=http://localhost:3000   # origin OAuth redirects land on (the frontend proxy)
OAUTH_FRONTEND_ORIGINS=http://localhost:3000    # comma-separated postMessage allowlist

# --- OAuth providers (inert mock sentinel — providers require non-empty values
# --- at bootstrap; real id+secret via Doppler when testing live OAuth) ------------
GOOGLE_CLIENT_ID=mock_value
GOOGLE_CLIENT_SECRET=mock_value
FACEBOOK_APP_ID=mock_value
FACEBOOK_APP_SECRET=mock_value

# --- Payments (stub mode: no real gateway calls) ---------------------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack | stripe
PAYMENT_STUB_MODE=true               # MUST be false in prod
# Sandbox gateway keys (needed only when PAYMENT_STUB_MODE=false) come from Doppler.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Feature flags / stub modes (keep stubs on locally) --------------------------
DOCUMENT_STORAGE_STUB_MODE=true      # true = no real S3/R2 writes
REPORT_PDF_STUB_MODE=true
PHONE_VERIFICATION_ENABLED=false
LEGAL_OPINION_ENABLED=false
SCHEDULER_ENABLED=true               # disabled under test
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Operational knobs (all have sensible in-code defaults; override as needed) ---
# OTP delivery / verification throttles
# OTP_CODE_TTL_SECONDS=600             # sent-code validity window
# OTP_MAX_RESENDS=3                    # resends allowed within the lockout window
# OTP_RESEND_LOCKOUT_SECONDS=1800      # resend-count window
# OTP_MAX_FAILURES=5                   # invalid attempts before a new code is required
# OTP_VERIFIED_MARKER_TTL_SECONDS=1800 # post-verify "completed" marker lifetime
# PASSWORD_MIN_LENGTH=8                # server-side password minimum length
# OAuth provider caches / short-lived tokens
# OAUTH_STATE_TTL_SECONDS=600          # anti-CSRF state validity
# OAUTH_JWKS_CACHE_SECONDS=300         # provider JWKS cache lifetime
# OAUTH_CLIENT_SECRET_JWT_TTL_SECONDS=300  # Apple client-secret JWT exp
# Drafts & abandonment lifetimes
# SIGNUP_DRAFT_TTL_DAYS=7
# AGENT_APPLICATION_DRAFT_TTL_DAYS=30
# VERIFICATION_ABANDONMENT_AGE_HOURS=24
# IDEMPOTENCY_KEY_TTL_HOURS=24
# Server-Sent Events transport
# SSE_HEARTBEAT_SECONDS=25
# SSE_QUEUE_MAXSIZE=100
# UI limits (frontend reads CHAT_MESSAGE_MAX_LENGTH via /config/public)
# CHAT_MESSAGE_MAX_LENGTH=2000
# DASHBOARD_RECENT_LIMIT=5
# EVIDENCE_PREVIEW_LIMIT=3
# ADMIN_DASHBOARD_RECENT_LIMIT=8
# AUDIT_PACK_CONSENT_PAGE_SIZE=1000
# CHARGEBACK_PACK_PAGE_SIZE=500
# NOTE: admin-tunable business rules (SLA-at-risk horizon, payout SLA, dispute
# min-length, share-link expiry, analytics trend window) live in the system_config
# store (ConfigKey), edited via the admin API — NOT here.

# --- Super admin seed (deterministic local credential, gates a local DB only) ----
SUPER_ADMIN_EMAIL=admin@veriprops.dev     # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=Admin123!local

# --- Third-party integration keys (all Doppler-managed; blank = stub/mock mode) --
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
TERMII_API_KEY=
TERMII_API_SECRET_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
# ZOHO_CLIENT_ID=                    # Zoho DocSign client id
# ZOHO_CLIENT_SECRET=                # via Doppler
# DOJAH_APP_ID=                      # via Doppler (required when KYC_PROVIDER=DOJAH)
# DOJAH_PRIVATE_KEY=                 # via Doppler
