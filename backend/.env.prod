# ==============================================================================
# Veriprops backend — PRODUCTION environment (.env.prod)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `appodus_active_env=prod`. This file carries ONLY non-secret,
# reviewable configuration. Every credential is Doppler-managed (`prd` config,
# synced to Vercel as env vars) and process env vars override this file.
# Keys left at CHANGE_ME are hard placeholders: `_enforce_prod_secret_policy`
# refuses to boot prod while AUTHJWT_SECRET_KEY / APPODUS_CLIENT_SECRET are
# placeholders, so a deploy without Doppler injection fails fast by design.
# Contract pins (test_env_hygiene.py): ENVIRONMENT=prod, OTP_MODE=random,
# SHOW_API=false, rate limiting ON, auth bypass OFF, SQL echo OFF, stubs OFF.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=prod
# FIXME(ops): confirm the real deployed backend origin before go-live.
APP_DOMAIN=https://api.veriprops.ng
SHOW_API=false                       # /docs hidden in production
LOG_LEVEL=INFO
LOGGER_FILE_PATH=/tmp/appodus/logs
LOGGER_FILE=logs.txt
DISABLE_RATE_LIMITING=false          # edge rate limiting MUST stay on
ENABLE_OUT_MESSAGING=true            # real email/SMS delivery

# --- Brand --------------------------------------------------------------------
BRAND=veriprops
BRAND_SUPPORT_EMAIL=support@veriprops.ng
BRAND_SUPPORT_PHONE=

# --- Auth / JWT (real values injected by Doppler; placeholders block boot) ------
AUTHJWT_SECRET_KEY=CHANGE_ME
AUTHJWT_COOKIE_SECURE=true
ALLOW_AUTH_BYPASS=false
APPODUS_CLIENT_SECRET=CHANGE_ME
APPODUS_CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME

# --- OTP (production REQUIRES random — startup fails otherwise) ------------------
OTP_MODE=random

# --- Database (password via Doppler) ---------------------------------------------
ACTIVE_DB=POSTGRES
DB_SCHEME=postgresql+asyncpg
DB_SERVER=pg-2d5721ad-learningforge.b.aivencloud.com
DB_PORT=17637
DB_USER=avnadmin
DB_PASSWORD=CHANGE_ME
DB_NAME=veriprops_prod
DB_ENABLE_LOGS=false                 # SQL echo leaks bound params — never in prod
DEPLOYMENT_IS_SERVERLESS=true        # Vercel: NullPool, no cached engines

# --- Email ------------------------------------------------------------------------
# SMTP/Mailpit is dev-only (SmtpEmailProvider hard-fails in prod); production email
# routes through the real provider whose credentials live in Doppler.
EMAIL_FROM_ADDRESS=noreply@veriprops.ng
EMAIL_FROM_NAME=Veriprops

# --- Redis / KV --------------------------------------------------------------------
REDIS_ENABLED=false                  # SQL KV fallback; flip on with Doppler-held creds
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_DB=0

# --- CORS / OAuth origins ------------------------------------------------------------
ALLOWED_ORIGINS=https://veriprops.ng,https://www.veriprops.ng
BACKEND_PUBLIC_ORIGIN=https://api.veriprops.ng
OAUTH_CALLBACK_BASE_URL=https://veriprops.ng
OAUTH_FRONTEND_ORIGINS=https://veriprops.ng,https://www.veriprops.ng

# --- OAuth providers (client ids are public; secrets via Doppler) ---------------------
GOOGLE_CLIENT_ID=477237984032-1dnvhncoq16mk3j2ebjque7gp9vapsqp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
FACEBOOK_APP_ID=mock_value           # FIXME(ops): set the real Facebook app id at launch
FACEBOOK_APP_SECRET=CHANGE_ME

# --- Payments (LIVE gateway — keys via Doppler) ----------------------------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack
PAYMENT_STUB_MODE=false              # real gateway webhooks drive PAID
FLUTTERWAVE_PUBLIC_KEY=CHANGE_ME
FLUTTERWAVE_SECRET_KEY=CHANGE_ME
FLUTTERWAVE_WEBHOOK_SECRET=CHANGE_ME
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
PAYSTACK_PUBLIC_KEY=CHANGE_ME
PAYSTACK_SECRET_KEY=CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Feature flags / providers (real implementations in production) ---------------------
DOCUMENT_STORAGE_STUB_MODE=false     # real S3 writes (AWS creds via Doppler)
REPORT_PDF_STUB_MODE=false           # real fpdf2 renderer
PHONE_VERIFICATION_ENABLED=false     # phone verified at the payment step (PRD §10.5)
LEGAL_OPINION_ENABLED=false          # launch gate: NBA sign-off + lawyer PI cover first
SCHEDULER_ENABLED=true
# FIXME(ops): flip to real providers (+ Doppler creds) when go-live requires them.
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Super admin seed (password via Doppler — placeholder blocks nothing here,
# --- but the first prod migration fails loudly if the real values are missing) ----------
SUPER_ADMIN_EMAIL=admin@veriprops.ng
SUPER_ADMIN_PASSWORD=CHANGE_ME

# --- Third-party integration keys — ALL via Doppler ---------------------------------------
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
TERMII_API_KEY=CHANGE_ME
TERMII_API_SECRET_KEY=CHANGE_ME
MAILJET_API_KEY=CHANGE_ME
MAILJET_API_SECRET=CHANGE_ME
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# DOJAH_APP_ID=
# DOJAH_PRIVATE_KEY=
