# ==============================================================================
# Veriprops backend — PRODUCTION environment (.env.prod)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `APPODUS_ACTIVE_ENV=prod`. This file carries ONLY non-secret,
# reviewable configuration. Every credential is Doppler-managed (`prd` config,
# injected by deploy.yml as deployment env vars) and process env vars override
# this file.
# Keys left at CHANGE_ME are hard placeholders: `_enforce_prod_secret_policy`
# refuses to boot prod while AUTHJWT_SECRET_KEY is a placeholder, so a deploy
# without Doppler injection fails fast by design.
# Contract pins (test_env_hygiene.py): ENVIRONMENT=prod, OTP_MODE=random,
# SHOW_API=false, rate limiting ON, auth bypass OFF, SQL echo OFF, stubs OFF.
# See backend/.env.example for the full set of settable keys and their possible values.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=prod                     # dev_personal | dev | test | staging | prod
# FIXME(ops): confirm the real deployed backend origin before go-live.
APP_DOMAIN=https://api.veriprops.ng  # absolute URL of this backend
SHOW_API=false                       # true | false  (/docs hidden in production)
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name (within LOGGER_FILE_PATH)
DISABLE_RATE_LIMITING=false          # true | false  (edge rate limiting MUST stay on)
ENABLE_OUT_MESSAGING=true            # true | false  (real email/SMS delivery)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops                      # brand slug
BRAND_SUPPORT_EMAIL=support@veriprops.ng   # customer support address
BRAND_SUPPORT_PHONE=                 # E.164 digits, no + (blank = none)

# --- Auth / JWT (real values injected by Doppler; placeholders block boot) ------
AUTHJWT_SECRET_KEY=CHANGE_ME         # SECRET: HS256 signing key — boot fails in prod while this is a placeholder

# --- OTP (production REQUIRES random — startup fails otherwise) ------------------
OTP_MODE=random                      # deterministic | random  (pinned to random for prod)

# --- Database (password via Doppler) ---------------------------------------------
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg         # SQLAlchemy driver scheme
DB_SERVER=pg-2d5721ad-learningforge.b.aivencloud.com   # managed Postgres host (Aiven)
DB_PORT=17637                        # DB port (int)
DB_USER=avnadmin                     # DB user
DB_PASSWORD=CHANGE_ME                # SECRET: via Doppler `prd`
DB_NAME=veriprops_prod               # database name
DB_ENABLE_LOGS=false                 # true | false  (SQL echo leaks bound params — never in prod)

# --- Email ------------------------------------------------------------------------
# SMTP/Mailpit is dev-only (SmtpEmailProvider hard-fails in prod); production email
# routes through the real provider whose credentials live in Doppler.
EMAIL_FROM_ADDRESS=noreply@veriprops.ng   # valid TLD required
EMAIL_FROM_NAME=Veriprops            # display name on outbound email

# --- Redis / KV --------------------------------------------------------------------
REDIS_ENABLED=false                  # true | false  (SQL KV fallback; flip on with Doppler-held creds)
# REDIS_HOST=                        # Redis host (via Doppler)
# REDIS_PORT=6379                    # Redis port (int)
# REDIS_DB=0                         # Redis logical DB index

# --- CORS / OAuth origins ------------------------------------------------------------
ALLOWED_ORIGINS=https://veriprops.ng,https://www.veriprops.ng   # comma-separated absolute origins (CORS allowlist)
BACKEND_PUBLIC_ORIGIN=https://api.veriprops.ng      # public origin of this backend service
OAUTH_CALLBACK_BASE_URL=https://veriprops.ng        # origin OAuth redirects land on
OAUTH_FRONTEND_ORIGINS=https://veriprops.ng,https://www.veriprops.ng   # comma-separated postMessage allowlist

# --- OAuth providers (client ids are public; secrets via Doppler) ---------------------
GOOGLE_CLIENT_ID=477237984032-1dnvhncoq16mk3j2ebjque7gp9vapsqp.apps.googleusercontent.com   # Google OAuth client id (public)
GOOGLE_CLIENT_SECRET=CHANGE_ME       # SECRET: via Doppler `prd`
FACEBOOK_APP_ID=mock_value           # FIXME(ops): set the real Facebook app id at launch
FACEBOOK_APP_SECRET=CHANGE_ME        # SECRET: via Doppler `prd`

# --- Payments (LIVE gateway — keys via Doppler) ----------------------------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack (stripe is enum-only — no live integration yet)
PAYMENT_STUB_MODE=false              # true | false  (pinned false for prod — real gateway webhooks drive PAID)
FLUTTERWAVE_PUBLIC_KEY=CHANGE_ME     # via Doppler `prd` (live key)
FLUTTERWAVE_SECRET_KEY=CHANGE_ME     # SECRET: via Doppler `prd`
FLUTTERWAVE_WEBHOOK_SECRET=CHANGE_ME # SECRET: via Doppler `prd`
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3   # Flutterwave API base URL
PAYSTACK_PUBLIC_KEY=CHANGE_ME        # via Doppler `prd` (live key)
PAYSTACK_SECRET_KEY=CHANGE_ME        # SECRET: via Doppler `prd`
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME    # SECRET: via Doppler `prd`
PAYSTACK_BASE_URL=https://api.paystack.co   # Paystack API base URL

# --- Feature flags / providers (real implementations in production) ---------------------
DOCUMENT_STORAGE_STUB_MODE=false     # true | false  (pinned false for prod — real S3 writes, AWS creds via Doppler)
REPORT_PDF_STUB_MODE=false           # true | false  (pinned false for prod — real fpdf2 renderer)
PHONE_VERIFICATION_ENABLED=false     # true | false  (phone verified at the payment step — PRD §10.5)
LEGAL_OPINION_ENABLED=false          # true | false  (launch gate: NBA sign-off + lawyer PI cover first)
SCHEDULER_ENABLED=true               # true | false
# FIXME(ops): flip to real providers (+ Doppler creds) when go-live requires them.
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Super admin seed (password via Doppler — placeholder blocks nothing here,
# --- but the first prod migration fails loudly if the real values are missing) ----------
SUPER_ADMIN_EMAIL=admin@veriprops.ng    # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=CHANGE_ME       # SECRET: via Doppler `prd`

# --- Third-party integration keys — ALL via Doppler ---------------------------------------
AWS_ACCESS_KEY=CHANGE_ME             # SECRET: via Doppler `prd`
AWS_SECRET_ACCESS_KEY=CHANGE_ME      # SECRET: via Doppler `prd`
TERMII_API_KEY=CHANGE_ME             # SECRET: via Doppler `prd`
TERMII_API_SECRET_KEY=CHANGE_ME      # SECRET: via Doppler `prd`
MAILJET_API_KEY=CHANGE_ME            # SECRET: via Doppler `prd`
MAILJET_API_SECRET=CHANGE_ME         # SECRET: via Doppler `prd`
RESEND_API_KEY=CHANGE_ME             # SECRET: via Doppler `prd`
# ZOHO_CLIENT_ID=                    # Zoho DocSign OAuth client id — set via Doppler `prd` when needed
# ZOHO_CLIENT_SECRET=                # SECRET: via Doppler `prd`
# DOJAH_APP_ID=                      # via Doppler `prd` (required when KYC_PROVIDER=DOJAH)
# DOJAH_PRIVATE_KEY=                 # SECRET: via Doppler `prd`
