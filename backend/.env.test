# ==============================================================================
# Veriprops backend — TEST environment (.env.test)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `appodus_active_env=test` (the pytest default — see conftest.py).
# Contract (enforced by test/unit/app/config/test_env_hygiene.py):
#   - fully inert & deterministic: no real credentials, no outbound side effects,
#     no shared infrastructure — a throwaway localhost Postgres + Mailpit only.
#   - NEVER add a secret value here. Secrets live in Doppler and are injected as
#     process env vars (which override this file). Tests need zero secrets.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=test                     # fixed: the test-env policies key off this
APP_DOMAIN=http://localhost:8000
SHOW_API=true
LOG_LEVEL=DEBUG
LOGGER_FILE_PATH=/tmp/appodus/logs
LOGGER_FILE=logs.txt
DISABLE_RATE_LIMITING=true           # throttles off so tests never flake on limits
ENABLE_OUT_MESSAGING=false           # e2e runs override to true (email lands in Mailpit)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops
BRAND_SUPPORT_EMAIL=support@veriprops.ng
BRAND_SUPPORT_PHONE=

# --- Auth / JWT (placeholder is fine outside prod/staging) ---------------------
AUTHJWT_SECRET_KEY=CHANGE_ME
AUTHJWT_COOKIE_SECURE=true           # __Host- cookies require Secure even locally
ALLOW_AUTH_BYPASS=false
APPODUS_CLIENT_SECRET=CHANGE_ME
APPODUS_CLIENT_SECRET_ENCRYPTION_KEY=CHANGE_ME

# --- OTP (test REQUIRES deterministic — startup fails otherwise) ---------------
OTP_MODE=deterministic               # every OTP is TEST_OTP (654123)

# --- Database (dedicated throwaway test DB, never shared infra) ----------------
ACTIVE_DB=POSTGRES
DB_SCHEME=postgresql+asyncpg
DB_SERVER=localhost                  # `postgres` inside docker compose
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=veriprops_test
DB_ENABLE_LOGS=false
DEPLOYMENT_IS_SERVERLESS=false

# --- Email (Mailpit captures everything; nothing leaves the machine) -----------
SMTP_HOST=localhost                  # `mailpit` inside docker compose
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=noreply@veriprops.dev
EMAIL_FROM_NAME=Veriprops

# --- Redis / KV (SQL KV fallback keeps tests self-contained) -------------------
REDIS_ENABLED=false

# --- CORS / OAuth origins -------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BACKEND_PUBLIC_ORIGIN=http://localhost:8000
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
OAUTH_FRONTEND_ORIGINS=http://localhost:3000

# --- OAuth providers (inert mock sentinel — providers require non-empty values
# --- at bootstrap; real secrets only ever come from Doppler) ---------------------
GOOGLE_CLIENT_ID=mock_value
GOOGLE_CLIENT_SECRET=mock_value
FACEBOOK_APP_ID=mock_value
FACEBOOK_APP_SECRET=mock_value

# --- Payments (stubbed; the stub-confirm endpoint drives PAID) ------------------
ACTIVE_PAYMENT_METHOD=flutterwave
PAYMENT_STUB_MODE=true
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Feature flags / stub modes (everything stubbed & side-effect free) ---------
DOCUMENT_STORAGE_STUB_MODE=true
REPORT_PDF_STUB_MODE=true
PHONE_VERIFICATION_ENABLED=false
LEGAL_OPINION_ENABLED=false
SCHEDULER_ENABLED=false              # sweeps are invoked directly by tests
GEOCODING_PROVIDER=STUB
KYC_PROVIDER=STUB
PRICING_FX_PROVIDER=STUB

# --- Super admin seed (deterministic test credential, not a secret: it gates a
# --- throwaway localhost DB only; pinned by the automation contract) ------------
SUPER_ADMIN_EMAIL=admin@veriprops.dev
SUPER_ADMIN_PASSWORD=Admin123!test
