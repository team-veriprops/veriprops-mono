# ==============================================================================
# Veriprops backend — TEST environment (.env.test)  [committed, config-only]
# ------------------------------------------------------------------------------
# Loaded when `APPODUS_ACTIVE_ENV=test` (the pytest default — see conftest.py).
# Contract (enforced by test/unit/app/config/test_env_hygiene.py):
#   - fully inert & deterministic: no real credentials, no outbound side effects,
#     no shared infrastructure — a throwaway localhost Postgres + Mailpit only.
#   - NEVER add a secret value here. Secrets live in Doppler and are injected as
#     process env vars (which override this file). Tests need zero secrets.
# Several values below (ENVIRONMENT, OTP_MODE, SCHEDULER_ENABLED, ENABLE_OUT_MESSAGING,
# DB_SERVER, DB_NAME, PAYMENT/DOCUMENT_STORAGE/REPORT_PDF_STUB_MODE, SMTP_HOST, SMTP_PORT)
# are pinned exact strings asserted by TestTestEnvContract — do not change them here.
# See backend/.env.example for the full set of settable keys and their possible values.
# ==============================================================================

# --- Core / environment -------------------------------------------------------
ENVIRONMENT=test                     # dev_personal | dev | test | staging | prod (fixed here: the test-env policies key off this)
APP_DOMAIN=http://localhost:8000     # absolute URL of this backend
SHOW_API=true                        # true | false  (false hides /docs — use in prod)
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGER_FILE_PATH=/tmp/appodus/logs   # directory for the rotating log file
LOGGER_FILE=logs.txt                 # log file name (within LOGGER_FILE_PATH)
DISABLE_RATE_LIMITING=true           # true | false  (throttles off so tests never flake on limits)
ENABLE_OUT_MESSAGING=false           # true | false  (e2e runs override to true — email lands in Mailpit)

# --- Brand --------------------------------------------------------------------
BRAND=veriprops                      # brand slug
BRAND_SUPPORT_EMAIL=support@veriprops.ng   # customer support address
BRAND_SUPPORT_PHONE=                 # E.164 digits, no + (blank = none)

# --- Auth / JWT (placeholder is fine outside prod/staging) ---------------------
AUTHJWT_SECRET_KEY=CHANGE_ME         # SECRET: HS256 signing key — placeholder acceptable in test

# --- OTP (test REQUIRES deterministic — startup fails otherwise) ---------------
OTP_MODE=deterministic               # deterministic | random  (every OTP is TEST_OTP / 654123)
WHATSAPP_PROVIDER=stub               # stub | meta  (pinned to stub — automated runs never reach Meta)

# --- Database (dedicated throwaway test DB, never shared infra) ----------------
ACTIVE_DB=POSTGRES                   # POSTGRES | MYSQL | MSSQL | ORACLE
DB_SCHEME=postgresql+asyncpg         # SQLAlchemy driver scheme
DB_SERVER=localhost                  # `postgres` inside docker compose
DB_PORT=5432                         # DB port (int)
DB_USER=postgres                     # DB user
DB_PASSWORD=CHANGE_ME                # SECRET: placeholder — test infra needs no real credential
DB_NAME=veriprops_test               # database name
DB_ENABLE_LOGS=false                 # true | false  (echoes SQL + bound params — false in prod)

# --- Email (Mailpit captures everything; nothing leaves the machine) -----------
SMTP_HOST=localhost                  # `mailpit` inside docker compose
SMTP_PORT=1025                       # 1025 (Mailpit) | 587 (STARTTLS) | 465 (TLS) | 25
SMTP_USE_TLS=false                   # true | false
EMAIL_FROM_ADDRESS=noreply@veriprops.dev   # valid TLD required
EMAIL_FROM_NAME=Veriprops            # display name on outbound email

# --- Redis / KV (SQL KV fallback keeps tests self-contained) -------------------
REDIS_ENABLED=false                  # true | false

# --- CORS / OAuth origins -------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000   # comma-separated absolute origins (CORS allowlist)
BACKEND_PUBLIC_ORIGIN=http://localhost:8000     # public origin of this backend service
OAUTH_CALLBACK_BASE_URL=http://localhost:3000   # origin OAuth redirects land on
OAUTH_FRONTEND_ORIGINS=http://localhost:3000    # comma-separated postMessage allowlist

# --- OAuth providers (inert mock sentinel — providers require non-empty values
# --- at bootstrap; real secrets only ever come from Doppler) ---------------------
GOOGLE_CLIENT_ID=mock_value          # Google OAuth client id (public identifier)
GOOGLE_CLIENT_SECRET=mock_value      # SECRET (inert placeholder)
FACEBOOK_APP_ID=mock_value           # Facebook app id (public identifier)
FACEBOOK_APP_SECRET=mock_value       # SECRET (inert placeholder)
APPLE_TEAM_ID=mock_value             # Apple developer team id (public identifier)
APPLE_CLIENT_ID=mock_value           # Apple services id (public identifier)
APPLE_KEY_ID=mock_value              # Apple key id (for the client-secret JWT)
APPLE_PRIVATE_KEY=mock_value         # SECRET (inert placeholder)

# --- Payments (stubbed; the stub-confirm endpoint drives PAID) ------------------
ACTIVE_PAYMENT_METHOD=flutterwave    # flutterwave | paystack | stripe (stripe is enum-only — no live integration yet)
PAYMENT_STUB_MODE=true               # true | false  (pinned true for test — no real gateway calls)
FLUTTERWAVE_PUBLIC_KEY=              # via Doppler (unused while stubbed)
FLUTTERWAVE_SECRET_KEY=              # SECRET: via Doppler (unused while stubbed)
FLUTTERWAVE_WEBHOOK_SECRET=          # SECRET: via Doppler (unused while stubbed)
PAYSTACK_PUBLIC_KEY=                 # via Doppler (unused while stubbed)
PAYSTACK_SECRET_KEY=                 # SECRET: via Doppler (unused while stubbed)
PAYSTACK_WEBHOOK_SECRET=             # SECRET: via Doppler (unused while stubbed)

# --- Feature flags / stub modes (everything stubbed & side-effect free) ---------
DOCUMENT_STORAGE_STUB_MODE=true      # true | false  (pinned true for test — no real S3/R2 writes)
REPORT_PDF_STUB_MODE=true            # true | false  (pinned true for test — no real fpdf2 renderer)
PHONE_VERIFICATION_ENABLED=false     # true | false
LEGAL_OPINION_ENABLED=false          # true | false  (launch gate — never default-on)
SCHEDULER_ENABLED=false              # true | false  (sweeps are invoked directly by tests instead)
GEOCODING_PROVIDER=STUB              # STUB | GOOGLE_PLACES
KYC_PROVIDER=STUB                    # STUB | DOJAH
PRICING_FX_PROVIDER=STUB             # STUB | OPENEXCHANGERATES

# --- Super admin seed (deterministic test credential, not a secret: it gates a
# --- throwaway localhost DB only; pinned by the automation contract) ------------
SUPER_ADMIN_EMAIL=admin@veriprops.dev     # valid TLD required (EmailStr rejects reserved .local)
SUPER_ADMIN_PASSWORD=Admin123!test   # SECRET-listed key, but a deterministic test-only credential — not a real secret
