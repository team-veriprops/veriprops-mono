{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "git": {
    "deploymentEnabled": false
  },

  "functions": {
    "api/index.py": {
      "maxDuration": 600,
      "includeFiles": "service_accounts/**"
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
