{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "export veriprops_active_env=local && alembic upgrade head",

  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "service_accounts/**"
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
