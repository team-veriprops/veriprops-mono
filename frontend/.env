# ==============================================================================
# Veriprops frontend — shared base env (.env)  [committed, config-only]
# ------------------------------------------------------------------------------
# Next.js loads .env for every environment; .env.test / .env.production override
# it per NODE_ENV, and the git-ignored .env.local overrides everything for
# personal/machine-specific values. These are the values for local `pnpm dev`.
# Server-only vars have NO NEXT_PUBLIC_ prefix and are never sent to the browser
# (read via src/lib/config/server.ts). NEXT_PUBLIC_* are inlined at build time —
# NEVER put a secret in a NEXT_PUBLIC_ var.
# Secrets are Doppler-managed and injected as env vars (or set in .env.local);
# committed files keep them empty — enforced by the backend hygiene guard test
# (backend/test/unit/app/config/test_env_hygiene.py).
# ==============================================================================

# --- Server-only (proxy target + shared secret) -------------------------------
# /api/* is rewritten to ${API_BASE_URL}/api/* by next.config.ts.
API_BASE_URL=http://localhost:8000        # backend origin — `http://backend:8000` inside compose
BACKEND_SECRET_KEY=                       # reserved for backend proxy auth — via Doppler / .env.local
EDGE_AUTH_SECRET=                       # SECRET: via Doppler — Cloudflare Transform Rule header value checked in proxy.ts; blank disables the trusted-edge check (local/test/e2e run open)
PROXY_TIMEOUT_MS=180000                 # rewrite-proxy timeout override in ms (any int; code default is 180000/180s, raised above Next's 30s default so a slow cold-start call doesn't get its socket reset)
# ADDITIONAL_DEV_ORIGINS=                 # comma-separated extra dev origins (LAN testing)

# --- Environment (drives automation gating in src/lib/automation.ts) ----------
# dev_personal|development|test => automation window hooks ON; staging|production => OFF.
NEXT_PUBLIC_ENVIRONMENT=dev_personal      # dev_personal | development | test | staging | production

# --- App identity / SEO -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Veriprops            # any string
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # any absolute URL (canonical/OG base)
NEXT_PUBLIC_API_PREFIX=/api             # API path prefix override

# --- Analytics (optional — leave empty locally) -------------------------------
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID= # Microsoft Clarity project id | empty (disabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=          # Google Maps JS API key (referrer-restricted) | empty

# --- OAuth provider button toggles ("true" hides the button) ------------------
NEXT_PUBLIC_OAUTH_GOOGLE_DISABLED=false   # true | false
NEXT_PUBLIC_OAUTH_APPLE_DISABLED=true     # true | false
NEXT_PUBLIC_OAUTH_FACEBOOK_DISABLED=true  # true | false
