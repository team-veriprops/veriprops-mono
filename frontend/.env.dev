# ==============================================================================
# Veriprops frontend — DEV (deployed) env (.env.dev)  [committed, config-only]
# ------------------------------------------------------------------------------
# Config for the deployed shared dev frontend (dev.veriprops.ng), NOT a
# developer's machine (that is .env / .env.local).
#
# NOT auto-loaded by Next.js (it only knows .env/.env.development/.env.test/
# .env.production). deploy.yml merges this file (base) with the Doppler `dev`
# config (override, via .github/scripts/doppler_env_args.sh) and passes every
# merged key to `vercel deploy` as --build-env AND --env flags, which override
# the .env.production values the preview build would otherwise inherit.
# Constraints that follow from that mechanism:
#   - values must not contain spaces (they travel as CLI flag arguments)
#   - ONLY keys that should override .env.production belong here
#   - NEVER add a secret key here — secrets live in the Doppler config; a
#     committed value would shadow it in review (enforced by the hygiene test)
# ==============================================================================

# Automation window hooks ON — the deployed dev env is the Playwright/QA target.
NEXT_PUBLIC_ENVIRONMENT=development       # dev_personal | development | test | staging | production

# Server-only proxy target — the deployed dev backend origin.
API_BASE_URL=https://api-dev.veriprops.ng # backend origin — server-only, proxied via /api/*

NEXT_PUBLIC_SITE_URL=https://dev.veriprops.ng # canonical/OG base for this deployment
