# ==============================================================================
# Veriprops frontend — PRODUCTION build env (.env.production)  [committed, config-only]
# ------------------------------------------------------------------------------
# Auto-loaded by Next.js when NODE_ENV=production (every `next build`), on top
# of .env. NEXT_PUBLIC_* values are inlined into the bundle at build time.
# These are prod-shaped defaults; per-deployment overrides (e.g. the staging
# build sets NEXT_PUBLIC_ENVIRONMENT=staging) come from Vercel env vars synced
# from Doppler, which take precedence over this file. No secrets here — ever.
# See frontend/.env for the full set of settable keys.
# ==============================================================================

# staging|production keep the automation window hooks OFF (fail-closed allowlist).
NEXT_PUBLIC_ENVIRONMENT=production        # dev_personal | development | test | staging | production (automation hooks OFF for staging|production)

# Server-only proxy target — the deployed backend origin.
# FIXME(ops): confirm the real backend origin; Vercel/Doppler may override.
API_BASE_URL=https://api.veriprops.ng     # backend origin — server-only, proxied via /api/*
BACKEND_SECRET_KEY=                       # reserved for backend proxy auth — must stay empty here (enforced by hygiene test)

NEXT_PUBLIC_SITE_URL=https://veriprops.ng # any absolute URL (canonical/OG base)

# Analytics ids are public identifiers; set the real Clarity id at launch
# (here or via Vercel/Doppler).
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID= # Microsoft Clarity project id | empty (disabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=          # Google Maps JS API key (referrer-restricted) | empty

# Only Google OAuth is live at launch.
NEXT_PUBLIC_OAUTH_GOOGLE_DISABLED=false   # true | false ("true" hides the button)
NEXT_PUBLIC_OAUTH_APPLE_DISABLED=true     # true | false
NEXT_PUBLIC_OAUTH_FACEBOOK_DISABLED=true  # true | false
