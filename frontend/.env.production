# ==============================================================================
# Veriprops frontend — PRODUCTION build env (.env.production)  [committed, config-only]
# ------------------------------------------------------------------------------
# Auto-loaded by Next.js when NODE_ENV=production (every `next build`), on top
# of the .env base. NEXT_PUBLIC_* values are inlined into the bundle at build
# time. These are prod-shaped defaults; dev/staging preview deploys override
# them via the committed .env.dev / .env.staging files (deploy.yml passes their
# keys as --build-env/--env flags), and Doppler-synced Vercel env vars take
# precedence over this file too. No secrets here — ever.
# Only keys whose production value differs from .env — or that pin a launch
# policy against .env drift — belong here. See frontend/.env for the full set
# of settable keys.
# ==============================================================================

# staging|production keep the automation window hooks OFF (fail-closed allowlist).
NEXT_PUBLIC_ENVIRONMENT=production        # dev_personal | development | test | staging | production (automation hooks OFF for staging|production)

# Server-only proxy target — the deployed backend origin.
API_BASE_URL=https://api.veriprops.ng     # backend origin — server-only, proxied via /api/*

NEXT_PUBLIC_SITE_URL=https://veriprops.ng # any absolute URL (canonical/OG base)

# Launch-time analytics ids (public identifiers) — set here or via Vercel/Doppler:
# NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Only Google OAuth is live at launch — pinned here as launch policy so a local
# toggle experiment in .env can never flip a provider on in production.
NEXT_PUBLIC_OAUTH_GOOGLE_DISABLED=false   # true | false ("true" hides the button)
NEXT_PUBLIC_OAUTH_APPLE_DISABLED=true     # true | false
NEXT_PUBLIC_OAUTH_FACEBOOK_DISABLED=true  # true | false
