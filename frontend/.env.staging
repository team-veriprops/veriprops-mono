# ==============================================================================
# Veriprops frontend — STAGING env (.env.staging)  [committed, config-only]
# ------------------------------------------------------------------------------
# Config for the staging frontend (staging.veriprops.ng), the human-QA
# environment — deployed on every push to the staging branch.
#
# NOT auto-loaded by Next.js (it only knows .env/.env.development/.env.test/
# .env.production). deploy.yml merges this file (base) with the Doppler `stg`
# config (override, via .github/scripts/doppler_env_args.sh) and passes every
# merged key to `vercel deploy` as --build-env AND --env flags, which override
# the .env.production values the preview build would otherwise inherit.
# Constraints that follow from that mechanism:
#   - values must not contain spaces (they travel as CLI flag arguments)
#   - ONLY keys that should override .env.production belong here
#   - NEVER add a secret key here — secrets live in the Doppler config; a
#     committed value would shadow it in review (enforced by the hygiene test)
# ==============================================================================

# staging keeps the automation window hooks OFF (fail-closed allowlist).
NEXT_PUBLIC_ENVIRONMENT=staging           # dev_personal | development | test | staging | production

# Server-only proxy target — the staging backend origin.
API_BASE_URL=https://api-staging.veriprops.ng # backend origin — server-only, proxied via /api/*

NEXT_PUBLIC_SITE_URL=https://staging.veriprops.ng # canonical/OG base for this deployment
