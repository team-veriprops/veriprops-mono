# ==============================================================================
# Veriprops frontend — TEST environment (.env.test)  [committed, config-only]
# ------------------------------------------------------------------------------
# Auto-loaded by Next.js when NODE_ENV=test, on top of the .env base. Next.js
# deliberately skips .env.local in test mode, so the committed .env + this file
# alone determine the test env — keep both deterministic (the QA automation
# contract depends on it) and free of secrets. Only keys whose test value
# differs from .env belong here; everything else inherits from .env
# (localhost API/site URLs, empty analytics ids, empty secrets).
# ==============================================================================

# Automation window hooks (__app_ready__, __auth_snapshot__, …) gate on this.
NEXT_PUBLIC_ENVIRONMENT=test              # dev_personal | development | test | staging | production (automation hooks ON for dev_personal|development|test)

# All OAuth buttons render so the popup flow is testable — pinned as a trio
# (automation contract), independent of the .env local-dev defaults.
NEXT_PUBLIC_OAUTH_GOOGLE_DISABLED=false   # true | false ("true" hides the button)
NEXT_PUBLIC_OAUTH_APPLE_DISABLED=false    # true | false
NEXT_PUBLIC_OAUTH_FACEBOOK_DISABLED=false # true | false
