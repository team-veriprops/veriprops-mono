# ==============================================================================
# Veriprops frontend — TEST environment (.env.test)  [committed, config-only]
# ------------------------------------------------------------------------------
# Auto-loaded by Next.js/Vitest when NODE_ENV=test, on top of .env. Next.js
# deliberately skips .env.local in test mode, so this file fully determines the
# test env — keep it deterministic (the QA automation contract depends on it)
# and free of secrets. See frontend/.env for the full set of settable keys.
# ==============================================================================

# Automation window hooks (__app_ready__, __auth_snapshot__, …) gate on this.
NEXT_PUBLIC_ENVIRONMENT=test              # dev_personal | development | test | staging | production (automation hooks ON for dev_personal|development|test)

# Backend under test runs locally (appodus_active_env=test on :8000).
API_BASE_URL=http://localhost:8000        # backend origin — server-only, proxied via /api/*
BACKEND_SECRET_KEY=                       # reserved for backend proxy auth — must stay empty here (enforced by hygiene test)

NEXT_PUBLIC_SITE_URL=http://localhost:3000    # any absolute URL (canonical/OG base)

# Analytics stay off; all OAuth buttons render so the popup flow is testable.
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID= # Microsoft Clarity project id | empty (disabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=          # Google Maps JS API key | empty
NEXT_PUBLIC_OAUTH_GOOGLE_DISABLED=false   # true | false ("true" hides the button)
NEXT_PUBLIC_OAUTH_APPLE_DISABLED=false    # true | false
NEXT_PUBLIC_OAUTH_FACEBOOK_DISABLED=false # true | false
