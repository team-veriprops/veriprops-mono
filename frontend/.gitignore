# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — committed ones are CONFIG-ONLY (no secrets; enforced by
# backend/test/unit/app/config/test_env_hygiene.py). `.env.local` stays
# git-ignored for personal overrides + the proxy secret.
.env*
!.env
!.env.test
!.env.dev
!.env.staging
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local HTTPS dev certificate (per-machine, generated by mkcert — see `pnpm dev:https`).
# The UAT suite needs TLS because WebKit drops the `__Host-` Secure session cookies over
# plain http; Playwright sets ignoreHTTPSErrors, so the cert need not be CA-trusted.
/certificates/

# UAT suite run artifacts — captured sessions/seed payload (per-run credentials) and the
# report/trace/video trail. The specs and helpers under e2e/ ARE committed.
e2e/.auth/
e2e/playwright-report/
e2e/test-results/
